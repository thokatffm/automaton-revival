{
  "name": "@conway/automaton",
  "version": "0.2.1",
  "description": "Conway Automaton - Sovereign AI Agent Runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./state/database.js": {
      "types": "./dist/state/database.d.ts",
      "default": "./dist/state/database.js"
    },
    "./backends/ledger.js": {
      "types": "./dist/backends/ledger.d.ts",
      "default": "./dist/backends/ledger.js"
    }
  },
  "bin": {
    "automaton": "dist/index.js",
    "conway-automaton": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thokatffm/automaton-revival.git"
  },
  "homepage": "https://conway.tech",
  "keywords": [
    "autonomous-agent",
    "sovereign-ai",
    "web4",
    "conway",
    "self-replicating"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "tsc && pnpm -r build",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run --testNamePattern \"security|injection|policy|financial\"",
    "test:financial": "vitest run --testNamePattern \"financial|spend|treasury\"",
    "test:ci": "vitest run --reporter=verbose",
    "clean": "rm -rf dist && pnpm -r clean"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^13.1.1",
    "bs58": "^6.0.0",
    "chalk": "^5.3.0",
    "cron-parser": "^4.9.0",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.24.0",
    "ora": "^8.0.0",
    "siwe": "^2.3.0",
    "tweetnacl": "^1.0.3",
    "ulid": "^2.3.0",
    "viem": "^2.44.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "jayson": "^5.0.0",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "uuid@<11.1.1": "^11.1.1",
      "rollup@<4.59.0": "^4.59.0",
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
